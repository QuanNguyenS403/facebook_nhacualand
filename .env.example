# ==============================================================================
# NHACUALAND.COM — AI AGENT COMPANY AUTONOMOUS ENVIRONMENT (.env.example)
# Phạm vi cô lập tuyệt đối: CHỈ DUY NHẤT TẠI D:\Facebook (100% Standalone)
# Mảng kinh doanh: Nền tảng Cho Thuê Bất Động Sản & Phòng Ở (nhacualand.com)
# ==============================================================================

# ── 1. PHẠM VI HỆ THỐNG & THÔNG TIN THƯƠNG HIỆU ───────────────────────────────
WORKSPACE_ROOT=D:/Facebook
ISOLATION_MODE=STRICT_STANDALONE_D_FACEBOOK
BRAND_ID=nhacualand
BRAND_NAME=Nhà Của Land
BRAND_TAGLINE=Tìm phòng ưng ý, an cư trọn vẹn — Không gian sống tiện nghi
BRAND_WEBSITE=https://nhacualand.com
BRAND_HOTLINE=0981753082
ADMIN_EMAIL=quannguyentop1lux@gmail.com
TIMEZONE=Asia/Ho_Chi_Minh

# ── 2. CHẾ ĐỘ ĐIỀU HÀNH AI AGENT TỰ ĐỘNG HÓA 100% (ZERO-TOUCH AUTONOMY) ───────
AUTONOMOUS_MODE=FULL_100
AUTO_PUBLISH=true
REQUIRE_HUMAN_APPROVAL=false
SELF_APPROVE_CONTENT=true
DRY_RUN=false
PUBLISH_TARGETS=facebook,instagram,threads
STRICT_BRAND_ASSET_GUARD=true
RATE_LIMIT_COOLDOWN_MINUTES=15
MAX_POSTS_PER_PLATFORM_PER_DAY=8

# ── 3. TRÌNH DUYỆT PLAYWRIGHT & PERSISTENT CHROME PROFILE ─────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_PREFER_CDP=true
CHROME_EXECUTABLE_PATH=C:/Users/ASUS/AppData/Local/Google/Chrome/Application/chrome.exe
CHROME_USER_DATA_DIR=D:/Facebook/data/browser_profile
CHROME_PROFILE_DIRECTORY=Profile 38
CHROME_REMOTE_DEBUGGING_PORT=9222

# ── 4. META FANPAGE (GRAPH API + BUSINESS SUITE RPA) ─────────────────────────
BRAND_FACEBOOK_PAGE=Nhacualand
BRAND_FACEBOOK_URL=https://www.facebook.com/1337253129481940
FACEBOOK_AUTO_PUBLISH=true
META_GRAPH_VERSION=v21.0
META_BUSINESS_ID=your_meta_business_id
META_APP_ID=your_meta_app_id
FB_USER_ID=your_facebook_user_id
FB_USER_TOKEN=your_facebook_user_access_token
META_PAGE_ID=your_fanpage_id
META_PAGE_ACCESS_TOKEN=your_fanpage_access_token

# ── 5. INSTAGRAM (PERSISTENT RPA + AUTO META SYNC) ───────────────────────────
BRAND_INSTAGRAM=nhacualand
BRAND_INSTAGRAM_URL=https://www.instagram.com/nhacualand/
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id
INSTAGRAM_AUTO_PUBLISH=true

# ── 6. THREADS (PERSISTENT RPA) ──────────────────────────────────────────────
BRAND_THREADS=nhacualand
BRAND_THREADS_URL=https://www.threads.com/@nhacualand
THREADS_USER_ID=your_threads_user_id
THREADS_AUTO_PUBLISH=true

# ── 7. GOOGLE AI, GOOGLE FLOW, VEO VIDEO & NANO BANANA IMAGE ──────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-4-argon
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_PRO_MODEL=gemini-3-pro-image
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

GOOGLE_FLOW_URL=https://flow.google.com/
GOOGLE_FLOW_ENABLED=true
GOOGLE_VEO_ENABLED=true
GOOGLE_IMAGE_ENABLED=true
VIDEO_DEFAULT_ASPECT_RATIO=9:16
VIDEO_DEFAULT_RESOLUTION=1080p
VIDEO_DEFAULT_DURATION_SECONDS=8
IMAGE_DEFAULT_ASPECT_RATIO=3:4
IMAGE_DEFAULT_SIZE=2K
